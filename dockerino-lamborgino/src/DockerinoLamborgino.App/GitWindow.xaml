<Window x:Class="DockerinoLamborgino.App.GitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git repositories" Width="900" Height="700" MinWidth="650" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Project" FontWeight="Bold"/>
            <ComboBox x:Name="Projects" DisplayMemberPath="Name" SelectionChanged="Projects_SelectionChanged" Margin="0,4,0,8"/>
            <TextBlock Text="Select repositories for fetch or pull. Select one repository to view its branches and status." TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,6">
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Padding="10,4" Margin="0,0,6,0"/>
                <Button x:Name="FetchButton" Content="Fetch selected" Click="Fetch_Click" Padding="10,4" Margin="0,0,6,0"/>
                <Button x:Name="PullButton" Content="Pull selected (fast-forward only)" Click="Pull_Click" Padding="10,4"/>
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GroupBox Header="Repositories (multi-select)" Margin="0,0,6,6">
                <ListBox x:Name="Repositories" SelectionMode="Extended" SelectionChanged="Repositories_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Path}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="1" Grid.RowSpan="2" Header="Branches — switch one repository" Margin="0,0,0,6">
                <DockPanel Margin="5">
                    <Button x:Name="SwitchButton" DockPanel.Dock="Bottom" Content="Switch to selected branch" Click="Switch_Click" Padding="8,4" Margin="0,6,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="● Local branches" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ListBox x:Name="LocalBranches" DisplayMemberPath="Name" SelectionChanged="LocalBranches_SelectionChanged"/>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="◆ Remote branches" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Switching to a remote branch may create a local tracking branch." TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <ListBox x:Name="RemoteBranches" DisplayMemberPath="Name" SelectionChanged="RemoteBranches_SelectionChanged"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="Working-tree status" Margin="0,0,6,6">
                <TextBox x:Name="Status" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
            <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="Results and errors">
                <TextBox x:Name="Results" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
