<Window x:Class="DockerinoLamborgino.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dockerino-lamborgino" Width="260" Height="720" MinWidth="250" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize" Background="#101A1D" Foreground="#D9E8E6"
        Icon="/DockerinoLamborgino.App;component/Assets/dockerino-lamborgino-icon.png"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#72C6BD"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCECE9"/>
            <Setter Property="Background" Value="#203337"/>
            <Setter Property="BorderBrush" Value="#385451"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#72C6BD"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A6F0E5"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D9E8E6"/></Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78AAA5"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#365C59" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#142326" BorderBrush="#29413F" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="16,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" ToolTip="Minimize" AutomationProperties.Name="Minimize dashboard" Click="Minimize_Click" Margin="2" Padding="9,4"/>
                        <Button Content="□" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore dashboard" Click="Maximize_Click" Margin="2" Padding="9,4"/>
                        <Button Content="×" ToolTip="Hide dashboard" AutomationProperties.Name="Hide dashboard" Click="Hide_Click" Margin="2" Padding="9,4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◒" Foreground="{StaticResource Accent}" FontSize="21" Margin="0,0,10,0"/>
                        <TextBlock Text="DOCKERINO" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text=" / LAMBORGINO" Foreground="#78AAA5" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="258"/>
                    <ColumnDefinition x:Name="ProjectToolsColumn" Width="0"/>
                    <ColumnDefinition x:Name="TerminalColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#152427" BorderBrush="#29413F" BorderThickness="0,0,1,0" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="PROJECTS" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                        <Button x:Name="AddProjectButton" DockPanel.Dock="Bottom" Content="+  Add project" Click="FindProject_Click"
                                HorizontalContentAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Add project"/>
                        <Button x:Name="NewTerminalButton" DockPanel.Dock="Bottom" Content="+  New terminal"
                                Click="NewSession_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                Background="#18282A" BorderBrush="#29413F" Foreground="#89A6A3"
                                AutomationProperties.Name="Open new terminal"/>
                        <ListBox x:Name="ProjectsList" SelectionChanged="ProjectsList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="ProjectsList_PreviewMouseLeftButtonDown"
                                 Background="Transparent" BorderThickness="0" Foreground="#D9E8E6">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,9"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#284340"/></Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#72C6BD"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Directory}" Foreground="#829D99" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="#111E20" BorderBrush="#29413F" BorderThickness="0,0,1,0" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="PROJECT TOOLS" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="SelectedProjectName" Text="Select a project" FontSize="20" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SelectedProjectPath" Foreground="#89A6A3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Button x:Name="EditProjectButton" Content="Project instructions &amp; configuration…" Click="ManageProjects_Click"
                                    HorizontalContentAlignment="Left" Margin="0,0,0,8" IsEnabled="False"/>
                            <Button x:Name="GitButton" Content="Git management…" Click="ManageGit_Click"
                                    HorizontalContentAlignment="Left" Margin="0,0,0,18" IsEnabled="False"/>
                            <TextBlock Text="LAUNCHES" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="NoActionsText" Text="No launch actions configured. Add them in project configuration."
                                       Foreground="#89A6A3" TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <ItemsControl x:Name="LaunchActionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="RunAction_Click" Loaded="LaunchActionButton_Loaded"
                                                HorizontalContentAlignment="Stretch" Margin="0,3" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#D9E8E6" FontSize="10"
                                                           TextWrapping="Wrap" Opacity="0.8" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="LaunchDescription" Foreground="#89A6A3" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock x:Name="StatusText" Text="Choose a project to see its tools." Foreground="#9AB8B4"
                                       TextWrapping="Wrap" Margin="0,18,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid x:Name="TerminalPanel" Grid.Column="2" Visibility="Collapsed" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button x:Name="NewTerminalTabButton" DockPanel.Dock="Right" Content="+" ToolTip="Open new terminal"
                                AutomationProperties.Name="Open new terminal" Width="34" Height="32" Padding="0"
                                FontSize="18" Click="NewSession_Click"/>
                        <ListBox x:Name="SessionsList" SelectionChanged="SessionsList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0" Foreground="#D9E8E6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabSurface" Background="#1A2A2D" BorderBrush="#29413F" BorderThickness="1" CornerRadius="5">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#284340"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#72C6BD"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="9,5,5,5">
                                        <Button DockPanel.Dock="Right" Content="×" Tag="{Binding}" Click="CloseSessionTab_Click"
                                                ToolTip="Close tab and stop its process" AutomationProperties.Name="Close terminal tab"
                                                Width="22" Height="22" Padding="0" Margin="8,0,0,0"
                                                Background="Transparent" BorderThickness="0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="145"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="#29413F" BorderThickness="1" CornerRadius="6" Background="#0B1416" ClipToBounds="True">
                        <Grid x:Name="TerminalHost"/>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
