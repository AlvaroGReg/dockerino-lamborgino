<Window x:Class="DockerinoLamborgino.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dockerino-lamborgino" Width="1000" Height="680" MinWidth="600" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResize" Background="#101A1D" Foreground="#D9E8E6"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#72C6BD"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCECE9"/>
            <Setter Property="Background" Value="#203337"/>
            <Setter Property="BorderBrush" Value="#385451"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#72C6BD"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A6F0E5"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D9E8E6"/></Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78AAA5"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#365C59" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#142326" BorderBrush="#29413F" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="16,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" ToolTip="Minimize" AutomationProperties.Name="Minimize dashboard" Click="Minimize_Click" Margin="2" Padding="9,4"/>
                        <Button Content="□" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore dashboard" Click="Maximize_Click" Margin="2" Padding="9,4"/>
                        <Button Content="×" ToolTip="Hide dashboard" AutomationProperties.Name="Hide dashboard" Click="Hide_Click" Margin="2" Padding="9,4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◒" Foreground="{StaticResource Accent}" FontSize="21" Margin="0,0,10,0"/>
                        <TextBlock Text="DOCKERINO" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text=" / LAMBORGINO" Foreground="#78AAA5" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid x:Name="ExpandedContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MenuColumn" Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="MenuPanel" Background="#152427" BorderBrush="#29413F" BorderThickness="0,0,1,0" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="PROJECTS" Style="{StaticResource SectionLabel}"/>
                            <Button Content="Find project…" Click="FindProject_Click" Margin="0,0,0,5"/>
                            <Button Content="Manage projects…" Click="ManageProjects_Click"/>
                            <Separator Margin="0,14" Background="#29413F"/>
                            <TextBlock Text="REPOSITORIES" Style="{StaticResource SectionLabel}"/>
                            <Button Content="Manage Git…" Click="ManageGit_Click"/>
                            <Separator Margin="0,14" Background="#29413F"/>
                            <TextBlock Text="LAUNCH CONFIGURATION" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Launch actions are not available yet." TextWrapping="Wrap"/>
                            <Separator Margin="0,14" Background="#29413F"/>
                            <TextBlock Text="SESSIONS" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="New terminal" Click="NewSession_Click" Margin="0,0,5,6"/>
                                <Button Content="Stop" Click="StopSession_Click" Margin="0,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="SessionsList" SelectionChanged="SessionsList_SelectionChanged" DisplayMemberPath="Label"
                                 Background="#101C1F" Foreground="#D9E8E6" BorderBrush="#29413F">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
                <DockPanel Grid.Column="1" Margin="16">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="MenuButton" Content="Hide menu" Click="Menu_Click" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                        <TextBlock x:Name="StatusText" Text="Choose a project or open a terminal to begin." VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#9AB8B4"/>
                    </DockPanel>
                    <Border BorderBrush="#29413F" BorderThickness="1" CornerRadius="6" Background="#0B1416" ClipToBounds="True">
                        <Grid x:Name="TerminalHost">
                            <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="◒" Foreground="#72C6BD" FontSize="42" HorizontalAlignment="Center"/>
                                <TextBlock Text="Your workspace is ready" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6"/>
                                <TextBlock Text="Select a session or start a new terminal." Foreground="#89A6A3" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
