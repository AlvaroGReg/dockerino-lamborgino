<Window x:Class="DockerinoLamborgino.App.ProjectManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project configuration" Width="900" Height="700" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Saved projects" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom">
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,6,0,0" Padding="6"/>
                <Button Content="New project…" Click="New_Click" Margin="0,6,0,0" Padding="6"/>
                <Button Content="Edit selected" Click="Edit_Click" Margin="0,6,0,0" Padding="6"/>
            </StackPanel>
            <ListBox x:Name="ProjectsList" DisplayMemberPath="Name" SelectionChanged="ProjectsList_SelectionChanged" AutomationProperties.Name="Saved projects"/>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Project name"/>
                <TextBox x:Name="NameBox" Margin="0,3,0,8"/>
                <TextBlock Text="Project directory"/>
                <DockPanel Margin="0,3,0,8">
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="6,0,0,0" Padding="8,3"/>
                    <TextBox x:Name="DirectoryBox"/>
                </DockPanel>
                <TextBlock Text="Actions (JSON array)" FontWeight="Bold"/>
                <TextBlock Text="Enter an array of actions. Each action has id, name, color (#RRGGBB), description and processes; each process has id, name, workingDirectory and steps; each step has id, command and optional dependsOnSuccessOf (an earlier step ID). IDs are unique GUIDs. Saving never runs commands."
                           TextWrapping="Wrap" Margin="0,4,0,6"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="Saved actions — execution available in Phase 5" FontWeight="Bold" Margin="0,8,0,3"/>
                <ListBox x:Name="ActionsList" DisplayMemberPath="Label" Height="65" AutomationProperties.Name="Saved actions, not executable"/>
                <TextBlock Text="Errors and status" FontWeight="Bold" Margin="0,8,0,3"/>
                <TextBox x:Name="ErrorsBox" IsReadOnly="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Errors and status"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Review and save…" Click="Save_Click" Padding="10,5" Margin="0,0,6,0"/>
                    <Button Content="Close" Click="Close_Click" Padding="10,5"/>
                </StackPanel>
            </StackPanel>
            <TextBox x:Name="ConfigurationBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" AutomationProperties.Name="Launch configuration JSON"/>
        </DockPanel>
    </Grid>
</Window>
