<Window x:Class="DockerinoLamborgino.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" SizeToContent="Manual" Title="Project launcher">
    <Grid x:Name="Surface" Background="Transparent"
          MouseEnter="Surface_MouseEnter" MouseLeave="Surface_MouseLeave"
          MouseLeftButtonDown="Surface_MouseLeftButtonDown"
          MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseLeftButtonUp"
          LostMouseCapture="Surface_LostMouseCapture">
        <Path x:Name="Glow" IsHitTestVisible="False" Fill="#9C488F8B" Opacity="0.45">
            <Path.Effect>
                <BlurEffect Radius="15" />
            </Path.Effect>
        </Path>
        <Path x:Name="Body" IsHitTestVisible="False" Fill="#E82E6968" Stroke="#FF76B4AD" StrokeThickness="1" />
        <TextBlock x:Name="Marker" Text="●" Foreground="#FFD0E7DF" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        <Button x:Name="ExitButton" Content="×" ToolTip="Exit application"
                AutomationProperties.Name="Exit application"
                Width="25" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="3" Visibility="Collapsed" Click="ExitButton_Click" />
    </Grid>
</Window>
