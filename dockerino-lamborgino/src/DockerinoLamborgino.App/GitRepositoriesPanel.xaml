<UserControl x:Class="DockerinoLamborgino.App.GitRepositoriesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="GitIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#DCECE9"/>
            <Setter Property="Background" Value="#203337"/>
            <Setter Property="BorderBrush" Value="#385451"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#72C6BD"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A6F0E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Expander x:Name="GitExpander" Header="GIT REPOSITORIES" IsExpanded="False"
              Expanded="GitExpander_Expanded" Foreground="#D9E8E6">
        <StackPanel Margin="0,6,0,0">
            <DockPanel Margin="0,0,0,6">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="↻" ToolTip="Refresh repository status and branches"
                        AutomationProperties.Name="Refresh Git repositories" Click="Refresh_Click"
                        Style="{StaticResource GitIconButton}"/>
                <TextBlock x:Name="GitSummary" Text="Select a project" Foreground="#89A6A3"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="NoRepositoriesText" Text="No Git repositories are associated with this project."
                       Foreground="#89A6A3" TextWrapping="Wrap" Margin="0,2,0,6" Visibility="Collapsed"/>
            <ItemsControl x:Name="Repositories">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#29413F" BorderThickness="1" CornerRadius="4"
                                Background="#152427" Padding="7" Margin="0,3">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="↻" Tag="{Binding}" ToolTip="Fetch this repository"
                                                AutomationProperties.Name="Fetch repository" Click="Fetch_Click"
                                                IsEnabled="{Binding CanOperate}" Style="{StaticResource GitIconButton}"/>
                                        <Button Content="↓" Tag="{Binding}" ToolTip="Pull this repository (fast-forward only)"
                                                AutomationProperties.Name="Pull repository" Click="Pull_Click"
                                                IsEnabled="{Binding CanOperate}" Style="{StaticResource GitIconButton}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding BranchSummary}" Foreground="#89A6A3" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,4,0,3"/>
                                <ComboBox ItemsSource="{Binding BranchChoices}" SelectedItem="{Binding SelectedBranch, Mode=OneWay}"
                                          Tag="{Binding}" DropDownClosed="Branch_DropDownClosed"
                                          IsEnabled="{Binding CanSwitch}" ToolTip="Selecting a branch switches immediately">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinWidth="190">
                                                <TextBlock x:Name="BranchLabel" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                <Rectangle x:Name="BranchSeparator" Height="1" Fill="#55716E"
                                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter TargetName="BranchLabel" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="BranchSeparator" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding Status}" Foreground="#A8C2BE" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding OperationMessage}" Foreground="#E5C27B" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Expander>
</UserControl>
