<Window x:Class="DockerinoLamborgino.App.ProjectManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project configuration" Width="1000" Height="800" MinWidth="750" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Saved projects" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom">
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,6,0,0" Padding="6"/>
                <Button Content="New project…" Click="New_Click" Margin="0,6,0,0" Padding="6"/>
                <Button Content="Edit selected" Click="Edit_Click" Margin="0,6,0,0" Padding="6"/>
            </StackPanel>
            <ListBox x:Name="ProjectsList" DisplayMemberPath="Name" AutomationProperties.Name="Saved projects"/>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Project name"/><TextBox x:Name="NameBox" Margin="0,3,0,8" AutomationProperties.Name="Project name"/>
                <TextBlock Text="Project directory"/>
                <DockPanel Margin="0,3,0,8"><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="6,0,0,0" Padding="8,3"/><TextBox x:Name="DirectoryBox" AutomationProperties.Name="Project directory"/></DockPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="Errors and status" FontWeight="Bold" Margin="0,8,0,3"/>
                <TextBox x:Name="ErrorsBox" IsReadOnly="True" TextWrapping="Wrap" Height="55" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Errors and status"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Review and save…" Click="Save_Click" Padding="10,5" Margin="0,0,6,0"/><Button Content="Close" Click="Close_Click" Padding="10,5"/></StackPanel>
            </StackPanel>
            <TabControl>
                <TabItem Header="Repositories">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="Associate repositories explicitly, including directories outside the project." TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0"><Button Content="Add repository…" Click="AddRepository_Click" Padding="8,4"/><Button Content="Remove repository" Click="RemoveRepository_Click" Padding="8,4" Margin="6,0,0,0"/></StackPanel>
                        <ListBox x:Name="RepositoriesList" AutomationProperties.Name="Associated repositories"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Actions">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0"><Button Content="Add action" Click="AddAction_Click" Padding="6"/><Button Content="Remove action" Click="RemoveAction_Click" Padding="6" Margin="0,6,0,0"/></StackPanel>
                            <ListBox x:Name="ActionsList" DisplayMemberPath="Name" SelectionChanged="ActionsList_SelectionChanged" AutomationProperties.Name="Actions"/>
                        </DockPanel>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ActionEditor" IsEnabled="False">
                                <TextBlock Text="Action name"/><TextBox x:Name="ActionNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Action name"/>
                                <TextBlock Text="Color (#RRGGBB)" Margin="0,6,0,0"/><TextBox x:Name="ActionColorBox" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Action color"/>
                                <TextBlock Text="Description" Margin="0,6,0,0"/><TextBox x:Name="ActionDescriptionBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Action description"/>
                                <CheckBox Content="Lanzado rápido (mostrar en la lista de proyectos)" IsChecked="{Binding IsQuickLaunch, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,6,0,0" AutomationProperties.Name="Quick launch"/>
                                <TextBlock Text="Processes (run independently)" FontWeight="Bold" Margin="0,10,0,3"/>
                                <ListBox x:Name="ProcessesList" DisplayMemberPath="Name" Height="65" SelectionChanged="ProcessesList_SelectionChanged" AutomationProperties.Name="Processes"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Button Content="Add process" Click="AddProcess_Click" Padding="6,3"/><Button Content="Remove process" Click="RemoveProcess_Click" Padding="6,3" Margin="6,0,0,0"/></StackPanel>
                                <StackPanel x:Name="ProcessEditor" IsEnabled="False">
                                    <TextBlock Text="Process name" Margin="0,8,0,0"/><TextBox x:Name="ProcessNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Process name"/>
                                    <TextBlock Text="Working directory" Margin="0,6,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseWorkingDirectory_Click" Margin="6,0,0,0"/><TextBox x:Name="WorkingDirectoryBox" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Working directory"/></DockPanel>
                                    <TextBlock Text="Steps (run in order; failure skips the rest)" FontWeight="Bold" Margin="0,10,0,3"/>
                                    <ListBox x:Name="StepsList" DisplayMemberPath="Command" Height="65" SelectionChanged="StepsList_SelectionChanged" AutomationProperties.Name="Steps"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Button Content="Add step" Click="AddStep_Click" Padding="6,3"/><Button Content="Remove step" Click="RemoveStep_Click" Padding="6,3" Margin="6,0,0,0"/><Button Content="Move up" Click="StepUp_Click" Padding="6,3" Margin="6,0,0,0"/><Button Content="Move down" Click="StepDown_Click" Padding="6,3" Margin="6,0,0,0"/></StackPanel>
                                    <StackPanel x:Name="StepEditor" IsEnabled="False"><TextBlock Text="Command" Margin="0,8,0,0"/><TextBox x:Name="CommandBox" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="45" TextWrapping="Wrap" AutomationProperties.Name="Step command"/></StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
