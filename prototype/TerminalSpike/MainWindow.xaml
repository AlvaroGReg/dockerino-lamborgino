<Window x:Class="TerminalSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal + Job Object spike" Height="680" Width="1000"
        MinHeight="420" MinWidth="640">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button x:Name="StartButton" Content="Iniciar pwsh" Padding="10,5" Margin="0,0,8,0" Click="StartButton_Click" />
            <Button x:Name="ChildButton" Content="Crear proceso hijo de prueba" Padding="10,5" Margin="0,0,8,0" IsEnabled="False" Click="ChildButton_Click" />
            <Button x:Name="VtButton" Content="Probar VT/UTF-8" Padding="10,5" Margin="0,0,8,0" IsEnabled="False" Click="VtButton_Click" />
            <Button x:Name="StopButton" Content="Detener sesión (Job)" Padding="10,5" IsEnabled="False" Click="StopButton_Click" />
            <TextBlock x:Name="StatusText" Text="Preparado" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <Border Margin="8" BorderBrush="#555" BorderThickness="1">
            <terminal:EasyTerminalControl x:Name="Terminal"
                                          xmlns:terminal="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
                                          StartupCommandLine="pwsh.exe -NoLogo -NoProfile -NoExit"
                                          LogConPTYOutput="True"
                                          FontSizeWhenSettingTheme="14" />
        </Border>
    </DockPanel>
</Window>
